---
import '../styles/global.css';
import { GITHUB, FOUNDER_LINKEDIN, NAV_ITEMS, SITE_DESCRIPTION, SITE_NAME, SITE_URL, type NavKey } from '../data/site';

type Link = { anchor: string; url: string };
type Service = { name: string; serviceType: string; description: string; path: string };
type Faq = { question: string; answer: string };
type Article = {
  headline: string;
  alternativeHeadline?: string;
  description: string;
  wordCount?: number;
  articleSection: string[];
};

export type Props = PageProps;

export interface PageProps {
  title: string;
  description: string;
  path: string;
  targetQuery: string;
  entity: string;
  intent: string;
  answer: string;
  summary: string;
  pageType: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'ServicePage' | 'ArticlePage' | 'FAQPage';
  dateModified: string;
  datePublished?: string;
  robots: string;
  includeCta: boolean;
  navCurrent: NavKey;
  breadcrumbs: Link[];
  internalLinks: Link[];
  keywords: string[];
  services: Service[];
  faq: Faq[];
  article?: Article;
}

const page: PageProps = Astro.props;
const canonical = `${SITE_URL}${page.path}`;
const pageId = `${canonical.replace(/\/$/, '')}/#webpage`.replace(/([^:]\/)\/+/g, '$1');
const orgId = `${SITE_URL}/#organization`;
const websiteId = `${SITE_URL}/#website`;
const ogImage = `${SITE_URL}/og.png`;

const organization = {
  '@type': 'Organization',
  '@id': orgId,
  name: SITE_NAME,
  alternateName: ['main.direct'],
  url: `${SITE_URL}/`,
  logo: {
    '@type': 'ImageObject',
    '@id': `${SITE_URL}/#logo`,
    url: `${SITE_URL}/assets/img/icon-512.png`,
    contentUrl: `${SITE_URL}/assets/img/icon-512.png`,
    width: 512,
    height: 512,
    caption: SITE_NAME
  },
  image: [{
    '@type': 'ImageObject',
    '@id': `${SITE_URL}/#ogimage`,
    url: ogImage,
    contentUrl: ogImage,
    width: 1200,
    height: 630,
    caption: 'Main Direct — B2B outreach supply engine'
  }],
  description: SITE_DESCRIPTION,
  founder: {
    '@type': 'Person',
    '@id': `${SITE_URL}/#costa-d`,
    name: 'Costa D',
    givenName: 'Konstantin',
    jobTitle: 'Founder',
    url: FOUNDER_LINKEDIN
  },
  areaServed: { '@type': 'Place', name: 'Worldwide' },
  knowsLanguage: ['en', 'ru'],
  knowsAbout: [
    'B2B outreach supply infrastructure',
    'contact discovery',
    'contact validation',
    'contact liveness',
    'email deliverability',
    'dedicated sending domains',
    'cold-email warm-up',
    'suppression handling'
  ],
  sameAs: [GITHUB, FOUNDER_LINKEDIN]
};

const graph: Record<string, unknown>[] = [
  organization,
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: `${SITE_URL}/`,
    name: SITE_NAME,
    description: SITE_DESCRIPTION,
    publisher: { '@id': orgId },
    inLanguage: 'en'
  },
  {
    '@type': page.pageType === 'ServicePage' ? 'WebPage' : page.pageType === 'ArticlePage' || page.pageType === 'FAQPage' ? 'WebPage' : page.pageType,
    '@id': pageId,
    url: canonical,
    name: page.title,
    description: page.description,
    isPartOf: { '@id': websiteId },
    about: { '@id': orgId },
    inLanguage: 'en',
    dateModified: page.dateModified,
    keywords: page.keywords.join(', '),
    speakable: {
      '@type': 'SpeakableSpec',
      cssSelector: ['h1', '.page-hero .lead', '.answer-block p']
    }
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${canonical.endsWith('/') ? canonical : `${canonical}/`}#breadcrumbs`,
    itemListElement: page.breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.anchor,
      item: `${SITE_URL}${crumb.url}`
    }))
  }
];

for (const service of page.services) {
  graph.push({
    '@type': 'Service',
    '@id': `${SITE_URL}${service.path.replace(/\/$/, '')}/#service`,
    url: `${SITE_URL}${service.path}`,
    name: service.name,
    serviceType: service.serviceType,
    description: service.description,
    provider: { '@id': orgId },
    areaServed: { '@type': 'Place', name: 'Worldwide' }
  });
}

if (page.article) {
  graph.push({
    '@type': 'Article',
    '@id': `${canonical.endsWith('/') ? canonical : `${canonical}/`}#article`,
    url: canonical,
    headline: page.article.headline,
    alternativeHeadline: page.article.alternativeHeadline,
    description: page.article.description,
    datePublished: page.datePublished ?? page.dateModified,
    dateModified: page.dateModified,
    inLanguage: 'en',
    wordCount: page.article.wordCount,
    articleSection: page.article.articleSection,
    author: { '@id': `${SITE_URL}/#costa-d` },
    publisher: { '@id': orgId },
    mainEntityOfPage: { '@id': pageId },
    image: { '@id': `${SITE_URL}/#ogimage` }
  });
}

if (page.faq.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonical.endsWith('/') ? canonical : `${canonical}/`}#faq`,
    url: canonical,
    inLanguage: 'en',
    mainEntity: page.faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer }
    }))
  });
}

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const navItems: readonly { href: string; label: string; key: NavKey }[] = NAV_ITEMS;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="robots" content={page.robots} />
    <meta name="keywords" content={page.keywords.join(', ')} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <meta property="og:type" content={page.article ? "article" : "website"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Main Direct: B2B contact data and email deliverability infrastructure." />
    {page.article && page.datePublished && <meta property="article:published_time" content={page.datePublished} />}
    {page.article && <meta property="article:modified_time" content={page.dateModified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Main Direct: B2B contact data and email deliverability infrastructure." />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <header class="site">
      <div class="wrap nav">
        <a class="logo" href="/" aria-label="Main Direct home">main<strong>.</strong>direct</a>
        <nav aria-label="Primary">
          <ul class="menu">
            {navItems.map((item) => (
              <li><a href={item.href} aria-current={page.navCurrent === item.key ? 'page' : undefined}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="button" href="/contact/">Start a review</a>
      </div>
    </header>

    <main id="main">
      <slot />
      {page.includeCta && (
        <section aria-labelledby="cta-title">
          <div class="wrap"><div class="cta-band">
            <h2 id="cta-title">Need the infrastructure, not another list?</h2>
            <p>Send the segment, target geographies, current data and sending setup. I’ll show whether the constraint is data quality, validation, deliverability or message architecture.</p>
            <a class="button" href="/contact/">Request infrastructure review</a>
          </div></div>
        </section>
      )}
    </main>

    <footer class="site">
      <div class="wrap">
        <div class="footer-grid">
          <div><a class="logo" href="/">main<strong>.</strong>direct</a><p style="margin-top:16px">B2B outreach supply engine: filters, verified contact supply and deliverability infrastructure.</p></div>
          <nav aria-label="Site"><h2>Site</h2><ul><li><a href="/">Home</a></li><li><a href="/services/">Modules</a></li><li><a href="/signal-atlas/">Signal Atlas</a></li><li><a href="/contact-supply/">Contact Supply</a></li><li><a href="/deliverability-engine/">Deliverability Engine</a></li><li><a href="/playbooks/self-supply/">Self-supply playbook</a></li><li><a href="/about/">About</a></li><li><a href="/faq/">FAQ</a></li></ul></nav>
          <nav aria-label="Technical"><h2>Technical</h2><ul><li><a href="/sitemap.xml">Sitemap</a></li><li><a href="/rss.xml">RSS</a></li><li><a href="/llms.txt">llms.txt</a></li><li><a href="/ai/">AI guide</a></li><li><a href="/ai/summary.md">AI summary</a></li><li><a href="/robots.txt">Robots</a></li></ul></nav>
          <div><h2>Contact</h2><p><a href="/contact/">Infrastructure review form</a></p><p>Remote · Worldwide<br>English · Russian</p></div>
        </div>
        <div class="footer-bottom"><span>© 2026 Main Direct</span><span>Built without trackers or cookies</span><a href="/privacy/">Privacy</a></div>
      </div>
    </footer>
  </body>
</html>
